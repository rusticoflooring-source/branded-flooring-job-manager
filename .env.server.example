# SERVER ONLY: set these in Vercel project environment variables.
# Never add VITE_ to a secret variable name. Never commit real values.
APP_URL=https://your-job-manager.example
# Optional: additional controlled app origins, comma-separated. Register their Xero callbacks too.
APP_ALLOWED_ORIGINS=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-existing-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
OPENAI_API_KEY=your-server-only-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
XERO_CLIENT_ID=your-xero-app-client-id
XERO_CLIENT_SECRET=your-server-only-xero-client-secret
XERO_SCOPES=offline_access accounting.invoices accounting.contacts.read accounting.settings.read
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-random-key
XERO_WEBHOOK_KEY=your-xero-app-webhook-signing-key
CRON_SECRET=replace-with-an-independent-random-secret